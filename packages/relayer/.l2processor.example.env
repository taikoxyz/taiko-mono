# Processor for the L2 to L1 direction: it reads MessageSent events on Taiko and lands
# processMessage on Ethereum. This is the direction where private relays matter, because a claim
# waiting in Ethereum's public mempool hands competitors the message and proof they need to take
# the fee.
#
# The addresses below are deliberately blank: they differ per network, and a wrong one here is
# worse than an obvious gap. Fill them from the deployment you are relaying for. Everything with a
# value is either infrastructure-local or a default worth keeping.

PROMETHEUS_HTTP_PORT=6063
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=relayer
DATABASE_HOST=localhost:3306
DATABASE_MAX_IDLE_CONNS=50
DATABASE_MAX_OPEN_CONNS=3000
DATABASE_CONN_MAX_LIFETIME=100000
QUEUE_USER=
QUEUE_PASSWORD=
QUEUE_HOST=localhost
QUEUE_PORT=5672
PROCESSOR_PRIVATE_KEY=

# Destination is Ethereum, source is Taiko.
#
# DEST_TAIKO_ADDRESS is required by the flag parser whichever direction this runs in, and is
# checked before any direction logic, so the processor will not start without it. It is unused when
# the destination is Ethereum; give it the Taiko address anyway.
DEST_TAIKO_ADDRESS=0x1000777700000000000000000000000000000001
DEST_BRIDGE_ADDRESS=
SRC_ERC20_VAULT_ADDRESS=
DEST_ERC20_VAULT_ADDRESS=
DEST_ERC721_VAULT_ADDRESS=
DEST_ERC1155_VAULT_ADDRESS=
SRC_SIGNAL_SERVICE_ADDRESS=
SRC_RPC_URL=
DEST_RPC_URL=

CONFIRMATIONS_BEFORE_PROCESSING=2
CORS_ORIGINS=*
NUM_GOROUTINES=50
BLOCK_BATCH_SIZE=100
HEADER_SYNC_INTERVAL_IN_SECONDS=2

# Endpoints that hand processMessage transactions to block builders without broadcasting them to
# the public mempool, in failover order. Only the broadcast goes private; nonces, gas prices and
# receipts still come from DEST_RPC_URL. One that refuses several sends in a row drops out of
# rotation for PRIVATE_RPC_RETRY_INTERVAL. Leave empty to send everything through DEST_RPC_URL.
#
# Use the maximum-privacy setting on each, as shown: the default on either shares transaction data
# with searchers, which is the opposite of what is wanted here.
DEST_PRIVATE_RPC_URLS=https://rpc.flashbots.net?hint=hash,https://rpc.mevblocker.io/fullprivacy
PRIVATE_RPC_RETRY_INTERVAL=5m

# Bounds one send. Defaults to 5m whenever DEST_PRIVATE_RPC_URLS is set, because a relay can accept
# a transaction that is never included and acceptance is the only signal this layer gets.
# TX_SEND_TIMEOUT=5m

# Milliseconds a message waits off the main queue after a transient failure before being offered
# again. It waits outside the consumer, so the replica keeps relaying other messages meanwhile.
# TRANSIENT_ERROR_QUEUE_EXPIRATION=30000
