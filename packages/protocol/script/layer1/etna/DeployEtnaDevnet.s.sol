pragma solidity ^0.8.26;

import { ERC1967Proxy } from "@openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol";
import { SafeCast } from "@openzeppelin/contracts/utils/math/SafeCast.sol";
import { Script, console2 } from "forge-std/src/Script.sol";
import { IEtnaInbox } from "src/layer1/etna/iface/IEtnaInbox.sol";
import { EtnaInbox } from "src/layer1/etna/impl/EtnaInbox.sol";
import { EtnaInboxBootstrap } from "src/layer1/etna/impl/EtnaInboxBootstrap.sol";
import { EssentialContract } from "src/shared/common/EssentialContract.sol";
import { EtnaSignalService } from "src/shared/signal/EtnaSignalService.sol";
import { SignalService } from "src/shared/signal/SignalService.sol";

/// @title DeployEtnaDevnet
/// @notice Deploys a new Etna chain starting from L2 block 0 in the owner-initialized order (spec
/// 10 steps 1 and 5), so the Inbox proxy address exists before the L2 `EtnaStaking` proxy that
/// fixes it. It supports only a new network: the Inbox's Unzen Inbox, fork time and origin
/// multisig are zero, so `init` writes the Etna start at block 0 itself; a switch from Unzen is
/// `DeployEtnaSwitch`. The steps:
/// 1. `deployInboxProxy()`: the Inbox proxy on `EtnaInboxBootstrap`, which only sets the owner,
///    then the L1 SignalService, an `EtnaSignalService` with `usesBeaconRoots` false, authorizing
///    it. Export them as INBOX_PROXY and SIGNAL_SERVICE.
///    The SignalService comes first because the L2 genesis fixes its address in the L2
///    SignalService.
/// 2. Off-script: build the L2 genesis, whose `EtnaStaking` proxy at
///    `l2EtnaStakingAddress(L2_CHAIN_ID)` fixes INBOX_PROXY and whose SignalService is an
///    `EtnaSignalService` with `usesBeaconRoots` true that proves against SIGNAL_SERVICE
///    (`script/layer2/build_etna_genesis.py` checks both SignalService values and the
///    `EtnaStaking` implementation's `inbox` in the generated bytecode).
/// 3. `deployInbox()`: the `EtnaInbox` implementation. The proxy owner upgrades to it and calls
///    `init` in one transaction: the script sends that call when the deployer owns the proxy and
///    otherwise logs it for the owner.
/// @dev Every call reads PRIVATE_KEY (the deployer). `deployInboxProxy()` also reads the optional
/// CONTRACT_OWNER, the owner of the proxies it deploys (the deployer if unset, empty or zero). An
/// optional variable that is set but malformed reverts the call instead of falling back to its
/// default.
/// `deployInboxProxy()`: L1_CHAIN_ID, which must equal this chain's id; L2_CHAIN_ID; and
/// REMOTE_SIGNAL_SERVICE (the L2 SignalService), which must be the genesis generator's
/// SignalService address for L2_CHAIN_ID (`l2SignalServiceAddress`), because the L1
/// SignalService fixes it as an immutable.
/// `deployInbox()`: INBOX_PROXY; SIGNAL_SERVICE, which must have code; ETNA_STAKING, which must be
/// the genesis generator's EtnaStaking proxy address for L2_CHAIN_ID (`l2EtnaStakingAddress`);
/// ETNA_PROOF_VERIFIER, which must have code; L1_CHAIN_ID, which must equal this chain's id;
/// L2_CHAIN_ID; MAX_BATCH_BLOCKS (in [1, 12,952]); FORCED_INCLUSION_FEE_GWEI and
/// FORCED_INCLUSION_FEE_DOUBLE_THRESHOLD (non-zero); PROTOCOL_FEE_RECIPIENT (the DAO treasury,
/// non-zero); GENESIS_BLOCK_HASH and GENESIS_STATE_ROOT (L2 block 0); ETNA_FALLBACK_KEYS, the
/// initial DAO fallback key list as comma-separated 33-byte compressed keys in hex, 1 to 128 of
/// them in strictly ascending order; ETNA_MIN_TOTAL_STAKE (token base units, any uint256);
/// FORCED_INCLUSION_DELAY (seconds, non-zero); MAX_ANCHOR_AGE (seconds, at least 1152); and the
/// optional ETNA_UNSETTLED_LIMIT (U, in [1, 262,144]), which defaults to
/// `DEFAULT_UNSETTLED_LIMIT` (151,200) if unset, empty or zero. ETNA_STAKING and U are the config
/// hash's third and fourth words, so the L2 genesis must use the same values. The other scripts
/// that read ETNA_UNSETTLED_LIMIT treat zero differently: `DeployEtnaStaking` defaults only an
/// unset or empty value and refuses zero, and `BuildEtnaReadinessL2Message` requires a nonzero
/// value. Set it explicitly, to the same nonzero value, for every script of one deployment.
/// The script checks only SIGNAL_SERVICE's and ETNA_PROOF_VERIFIER's code, L1_CHAIN_ID,
/// REMOTE_SIGNAL_SERVICE, ETNA_STAKING and the length of each ETNA_FALLBACK_KEYS entry itself;
/// the constructors and `init` check the other bounds listed above, so a logged owner call is
/// validated when the owner sends it. Nothing on chain checks the rest, which the operator must
/// ensure: MAX_ANCHOR_AGE above the L1 finality delay (spec 11), which is three epochs (1152 s on
/// Ethereum) plus the deployment's allowance for slots missed at an epoch boundary and for nodes'
/// delay in importing the finalization, so on Ethereum 1152 s itself is too low, plus the time
/// 1,024 L2 blocks take, with an allowance, so proposers can keep an anchor until the next multiple
/// of 1,024 (spec 11 PARAM-11-5; without it anchors move when they age out); genesis values
/// that match the L2 genesis; and nodes and guests using the same configuration. A verifier that
/// accepts every proof is for ephemeral devnets only.
/// @custom:security-contact security@taiko.xyz
contract DeployEtnaDevnet is Script {
    /// @notice U, the maximum number of unsettled L2 blocks, when ETNA_UNSETTLED_LIMIT is unset,
    /// empty or zero: 151,200, about seven days of 4-second blocks.
    uint64 public constant DEFAULT_UNSETTLED_LIMIT = 151_200;

    // ---------------------------------------------------------------
    // External & Public Functions
    // ---------------------------------------------------------------

    /// @notice Deploys the Inbox proxy on its bootstrap implementation and the L1 SignalService
    /// authorizing it (step 1).
    /// @return proxy_ The Inbox proxy, owned by CONTRACT_OWNER or the deployer.
    /// @return signalService_ The L1 SignalService proxy, with the same owner.
    function deployInboxProxy() external virtual returns (address proxy_, address signalService_) {
        uint256 privateKey = _privateKey();
        address owner = _owner(privateKey);
        require(vm.envUint("L1_CHAIN_ID") == block.chainid, L1ChainIdMismatch());
        address remoteSignalService = vm.envAddress("REMOTE_SIGNAL_SERVICE");
        require(
            remoteSignalService == l2SignalServiceAddress(_envUint64("L2_CHAIN_ID")),
            RemoteSignalServiceMismatch()
        );

        vm.startBroadcast(privateKey);
        address bootstrap = address(new EtnaInboxBootstrap());
        proxy_ = address(
            new ERC1967Proxy(bootstrap, abi.encodeCall(EtnaInboxBootstrap.init, (owner)))
        );
        // No extra pauser: the owner can pause, and an immutable pauser would outlive a later
        // ownership transfer.
        address signalImpl =
            address(new EtnaSignalService(proxy_, remoteSignalService, address(0), false));
        signalService_ =
            address(new ERC1967Proxy(signalImpl, abi.encodeCall(SignalService.init, (owner))));
        vm.stopBroadcast();

        console2.log("EtnaInbox proxy (bootstrap):", proxy_);
        console2.log("  bootstrap implementation:", bootstrap);
        console2.log("  owner:", owner);
        console2.log("SignalService proxy:", signalService_);
        console2.log("  owner:", owner);
        console2.log("Export INBOX_PROXY and SIGNAL_SERVICE, then build the L2 genesis.");
    }

    /// @notice Deploys the `EtnaInbox` implementation over SIGNAL_SERVICE, then upgrades the proxy
    /// to it and initializes it if the deployer owns the proxy (step 3).
    /// @dev Otherwise logs `ownerInitCall(inboxImpl_)` for the proxy owner to send to
    /// INBOX_PROXY. Reverts before broadcasting if ETNA_STAKING is not the expected EtnaStaking
    /// proxy, SIGNAL_SERVICE or ETNA_PROOF_VERIFIER has no code or L1_CHAIN_ID is not this
    /// chain's id.
    /// @return inboxImpl_ The `EtnaInbox` implementation.
    function deployInbox() external virtual returns (address inboxImpl_) {
        uint256 privateKey = _privateKey();
        address proxy = vm.envAddress("INBOX_PROXY");
        IEtnaInbox.Config memory config = _inboxConfig();
        require(config.signalService.code.length != 0, SignalServiceHasNoCode());
        require(config.proofVerifier.code.length != 0, ProofVerifierHasNoCode());
        require(vm.envUint("L1_CHAIN_ID") == block.chainid, L1ChainIdMismatch());
        bool deployerOwnsProxy = EssentialContract(proxy).owner() == vm.addr(privateKey);

        vm.startBroadcast(privateKey);
        inboxImpl_ = address(new EtnaInbox(config));
        if (deployerOwnsProxy) {
            EssentialContract(proxy).upgradeToAndCall(inboxImpl_, _initCall());
        }
        vm.stopBroadcast();

        console2.log("EtnaInbox implementation:", inboxImpl_);
        console2.log("EtnaInbox proxy:", proxy);
        if (deployerOwnsProxy) {
            console2.log("  upgraded and initialized by its owner, the deployer");
        } else {
            console2.log("  owner:", EssentialContract(proxy).owner());
            console2.log("  still on the bootstrap; its owner must send it this call:");
            console2.logBytes(ownerInitCall(inboxImpl_));
        }
    }

    /// @notice Returns the L2 SignalService proxy address the genesis generator assigns to an L2
    /// chain: the chain id's decimal digits read as hex, then zeros, then 5, as
    /// `getConstantAddress(chainId, 5)` in `test/genesis/data/genesis_config.js`.
    /// @param _l2ChainId The L2 chain id, non-zero.
    /// @return The address, for example 0x1670000000000000000000000000000000000005 for 167000.
    function l2SignalServiceAddress(uint64 _l2ChainId) public pure returns (address) {
        require(_l2ChainId != 0, RemoteSignalServiceMismatch());
        return _l2ConstantAddress(_l2ChainId, 5);
    }

    /// @notice Returns the L2 `EtnaStaking` proxy address the genesis generator assigns to an L2
    /// chain: the chain id's decimal digits read as hex, then zeros, then 10003, as
    /// `getConstantAddress(chainId, 10003)` in `test/genesis/data/genesis_config.js`.
    /// @param _l2ChainId The L2 chain id, non-zero.
    /// @return The address, for example 0x1670010000000000000000000000000000010003 for 167001.
    function l2EtnaStakingAddress(uint64 _l2ChainId) public pure returns (address) {
        require(_l2ChainId != 0, EtnaStakingMismatch());
        return _l2ConstantAddress(_l2ChainId, 0x10003);
    }

    /// @notice Returns the call the Inbox proxy owner sends to INBOX_PROXY: `upgradeToAndCall` to
    /// `_inboxImpl` with `init` over the genesis environment.
    /// @param _inboxImpl The `EtnaInbox` implementation.
    /// @return The calldata.
    function ownerInitCall(address _inboxImpl) public view returns (bytes memory) {
        return abi.encodeCall(EtnaInbox.upgradeToAndCall, (_inboxImpl, _initCall()));
    }

    // ---------------------------------------------------------------
    // Internal & Private Functions
    // ---------------------------------------------------------------

    /// @dev Reads a non-zero deployment key.
    /// @return The key passed to the broadcast cheatcode.
    function _privateKey() internal view returns (uint256) {
        uint256 key = vm.envUint("PRIVATE_KEY");
        require(key != 0, InvalidPrivateKey());
        return key;
    }

    /// @dev Reads the owner of the deployed proxies, falling back to the deployer when
    /// CONTRACT_OWNER is unset, empty or zero. A malformed value reverts.
    /// @param _key The deployment key.
    /// @return The owner.
    function _owner(uint256 _key) internal view virtual returns (address) {
        address owner = _isSet("CONTRACT_OWNER") ? vm.envAddress("CONTRACT_OWNER") : address(0);
        return owner == address(0) ? vm.addr(_key) : owner;
    }

    /// @dev Reads the Inbox implementation's configuration. A new network has no Unzen Inbox, fork
    /// time or origin multisig, so all three are zero and `init` writes the start at block 0.
    /// @return The Inbox configuration.
    function _inboxConfig() internal view virtual returns (IEtnaInbox.Config memory) {
        return IEtnaInbox.Config({
            proofVerifier: vm.envAddress("ETNA_PROOF_VERIFIER"),
            signalService: vm.envAddress("SIGNAL_SERVICE"),
            etnaStaking: _etnaStaking(),
            l2ChainId: _envUint64("L2_CHAIN_ID"),
            maxBatchBlocks: _envUint64("MAX_BATCH_BLOCKS"),
            forcedInclusionFeeInGwei: _envUint64("FORCED_INCLUSION_FEE_GWEI"),
            forcedInclusionFeeDoubleThreshold: _envUint64("FORCED_INCLUSION_FEE_DOUBLE_THRESHOLD"),
            protocolFeeRecipient: vm.envAddress("PROTOCOL_FEE_RECIPIENT"),
            unzenInbox: address(0),
            etnaForkTime: 0,
            originMultisig: address(0),
            unsettledLimit: _unsettledLimit()
        });
    }

    /// @dev Reads ETNA_STAKING, the `EtnaStaking` proxy on L2. On a new network it is the genesis
    /// predeploy, so it must be the generator's address for L2_CHAIN_ID.
    /// @return staking_ The EtnaStaking proxy.
    function _etnaStaking() internal view virtual returns (address staking_) {
        staking_ = vm.envAddress("ETNA_STAKING");
        require(staking_ == l2EtnaStakingAddress(_envUint64("L2_CHAIN_ID")), EtnaStakingMismatch());
    }

    /// @dev Reads U, defaulting to `DEFAULT_UNSETTLED_LIMIT` when ETNA_UNSETTLED_LIMIT is unset,
    /// empty or zero. A malformed value reverts.
    /// @return The maximum number of unsettled L2 blocks.
    function _unsettledLimit() internal view returns (uint64) {
        uint256 limit = _isSet("ETNA_UNSETTLED_LIMIT") ? vm.envUint("ETNA_UNSETTLED_LIMIT") : 0;
        return limit == 0 ? DEFAULT_UNSETTLED_LIMIT : SafeCast.toUint64(limit);
    }

    /// @dev Encodes `init` over the genesis environment.
    /// @return The `init` calldata.
    function _initCall() internal view returns (bytes memory) {
        (bytes32 genesisHash, bytes32 genesisRoot) = _genesisBlock();
        IEtnaInbox.InitParams memory params = IEtnaInbox.InitParams({
            genesisBlockHash: genesisHash,
            genesisStateRoot: genesisRoot,
            fallbackKeys: _fallbackKeys(),
            minTotalStake: vm.envUint("ETNA_MIN_TOTAL_STAKE"),
            forcedInclusionDelay: vm.envUint("FORCED_INCLUSION_DELAY"),
            maxAnchorAge: vm.envUint("MAX_ANCHOR_AGE")
        });
        return abi.encodeCall(EtnaInbox.init, (params));
    }

    /// @dev Reads ETNA_FALLBACK_KEYS, comma-separated 33-byte compressed keys `prefix ‖ X` in hex,
    /// in the given order. `init` checks the count, the keys and their order.
    /// @return keys_ The fallback key list.
    function _fallbackKeys() internal view returns (IEtnaInbox.FallbackKey[] memory keys_) {
        bytes[] memory encoded = vm.envBytes("ETNA_FALLBACK_KEYS", ",");
        keys_ = new IEtnaInbox.FallbackKey[](encoded.length);
        for (uint256 i; i < encoded.length; ++i) {
            bytes memory key = encoded[i];
            require(key.length == 33, InvalidFallbackKeyLength());
            bytes32 x;
            assembly ("memory-safe") {
                x := mload(add(key, 33))
            }
            keys_[i] = IEtnaInbox.FallbackKey({ ckPrefix: uint8(key[0]), ckX: x });
        }
    }

    /// @dev Reads the block-zero identity for a new chain; switching deployments leave it unwritten.
    /// @return hash_ The genesis block hash.
    /// @return root_ The genesis state root.
    function _genesisBlock() internal view virtual returns (bytes32 hash_, bytes32 root_) {
        return (vm.envBytes32("GENESIS_BLOCK_HASH"), vm.envBytes32("GENESIS_STATE_ROOT"));
    }

    /// @dev Reads an environment integer and rejects values outside uint64.
    /// @param _name The variable name.
    /// @return The uint64 value.
    function _envUint64(string memory _name) internal view returns (uint64) {
        return SafeCast.toUint64(vm.envUint(_name));
    }

    /// @dev Returns the genesis generator's `getConstantAddress(_l2ChainId, _id)`: the chain id's
    /// decimal digits read as hex in the top nibbles, then zeros, then `_id`.
    /// @param _l2ChainId The L2 chain id, non-zero.
    /// @param _id The low bits.
    /// @return The address.
    function _l2ConstantAddress(
        uint64 _l2ChainId,
        uint160 _id
    )
        private
        pure
        returns (address)
    {
        uint256 power = 1;
        while (power <= _l2ChainId / 10) {
            power *= 10;
        }
        uint256 prefix;
        uint256 digits;
        for (; power != 0; power /= 10) {
            prefix = (prefix << 4) | ((_l2ChainId / power) % 10);
            ++digits;
        }
        return address(uint160(prefix << (4 * (40 - digits))) | _id);
    }

    /// @dev Returns whether an optional variable holds a non-empty value, which the caller then
    /// parses strictly. `vm.envOr` would also return its default for a malformed value.
    /// @param _name The variable name.
    /// @return Whether the variable is set and non-empty.
    function _isSet(string memory _name) private view returns (bool) {
        return vm.envExists(_name) && bytes(vm.envString(_name)).length != 0;
    }

    // ---------------------------------------------------------------
    // Custom Errors
    // ---------------------------------------------------------------

    /// @notice PRIVATE_KEY is zero.
    error InvalidPrivateKey();
    /// @notice L1_CHAIN_ID is not this chain's id.
    error L1ChainIdMismatch();
    /// @notice REMOTE_SIGNAL_SERVICE is not the L2 SignalService address for L2_CHAIN_ID.
    error RemoteSignalServiceMismatch();
    /// @notice ETNA_STAKING is not the expected `EtnaStaking` proxy, or the L2 chain id is zero.
    error EtnaStakingMismatch();
    /// @notice ETNA_PROOF_VERIFIER has no code.
    error ProofVerifierHasNoCode();
    /// @notice SIGNAL_SERVICE has no code.
    error SignalServiceHasNoCode();
    /// @notice An ETNA_FALLBACK_KEYS entry is not 33 bytes.
    error InvalidFallbackKeyLength();
}
