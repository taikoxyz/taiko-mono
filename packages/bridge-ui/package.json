{
  "name": "bridge-ui",
  "version": "2.19.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:a3": "vite dev --mode a3",
    "build": "vite build",
    "preview": "vite preview",
    "test:pw": "playwright test",
    "test:unit": "vitest run --silent",
    "test:unit:debug": "vitest run",
    "test:unit:coverage": "vitest run --silent --coverage",
    "test:unit:watch": "vitest",
    "svelte:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --ignore ./wagmi.config.ts ./src/generated",
    "svelte:check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --ignore ./wagmi.config.ts --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "pnpm format && eslint . --fix",
    "generate:abi": "pnpm --dir ../protocol compile:shared && wagmi generate",
    "export:config": "pnpm ./scripts/exportJsonToEnv.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/debug": "^4.1.13",
    "@types/object-hash": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@wagmi/cli": "^2.10.0",
    "abitype": "^1.3.0",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.1",
    "daisyui": "^4.12.24",
    "dotenv": "^16.6.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-svelte": "^2.46.1",
    "ethereum-address": "^0.0.4",
    "jsdom": "^24.1.3",
    "lokijs": "^1.5.12",
    "postcss": "^8.5.31",
    "postcss-import": "15.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^4.2.20",
    "svelte-check": "^3.8.6",
    "tailwindcss": "^3.4.19",
    "ts-morph": "^19.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.1",
    "vitest-fetch-mock": "^0.4.5",
    "vitest-mock-extended": "1.3.2"
  },
  "type": "module",
  "dependencies": {
    "@moralisweb3/common-evm-utils": "^2.27.2",
    "@wagmi/connectors": "^4.3.10",
    "@wagmi/core": "^2.22.1",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "@walletconnect/modal": "^2.7.0",
    "@web3modal/wagmi": "^4.1.11",
    "@zerodevx/svelte-toast": "^0.9.6",
    "axios": "^1.20.0",
    "buffer": "^6.0.3",
    "debug": "^4.4.3",
    "events": "^3.3.0",
    "moralis": "^2.27.2",
    "object-hash": "^3.0.0",
    "svelte-i18n": "^4.0.1",
    "viem": "^2.57.11"
  }
}
