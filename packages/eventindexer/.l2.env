# Shared database/API settings. Replace the placeholders before running.
DATABASE_USER=indexer
DATABASE_PASSWORD=replace-me
DATABASE_HOST=127.0.0.1:3306
DATABASE_NAME=indexer
DATABASE_MAX_IDLE_CONNS=50
DATABASE_MAX_OPEN_CONNS=200
DATABASE_CONN_MAX_LIFETIME=10
HTTP_PORT=4102
METRICS_HTTP_PORT=6061

# NFT indexer settings; the query API does not need RPC.
RPC_URL=http://127.0.0.1:8545
INDEX_NFTS=true
BLOCK_BATCH_SIZE=10
SYNC_MODE=sync
# Accept only the legacy bootstrap overlap; never bypass resync/missing-watermark guards.
ALLOW_UNCLAIMED_BALANCE_REPLAY=false
