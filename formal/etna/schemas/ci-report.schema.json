{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact-revision Etna formal run report",
  "type": "object",
  "required": [
    "schema_version",
    "verification_sha",
    "status",
    "jobs",
    "release_obligations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verification_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "status": {
      "enum": ["passed", "not-applicable"]
    },
    "jobs": {
      "type": "object"
    },
    "proof_levels": {
      "type": "object",
      "additionalProperties": {
        "enum": ["spec-proved", "rust-refinement-proved"]
      }
    },
    "release_obligations": {
      "type": "object",
      "required": [
        "GUEST-SOUNDNESS",
        "TIME-RULE-REFINEMENT",
        "SOLIDITY-BYTECODE-REFINEMENT"
      ],
      "additionalProperties": {
        "enum": ["pending", "implementation-proved"]
      }
    },
    "protocol_ownership": {
      "type": "object",
      "required": [
        "mode",
        "event_projection_sha256",
        "compared_revision",
        "compared_projection_sha256",
        "tested_revision",
        "tested_projection_sha256",
        "scope",
        "meaning"
      ],
      "properties": {
        "mode": {
          "enum": ["premerge", "adopted"]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "meaning": {
          "type": "string"
        },
        "event_projection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compared_projection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tested_projection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compared_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tested_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    }
  }
}
