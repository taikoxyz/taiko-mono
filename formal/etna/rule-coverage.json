  "via": {
    "LAND-6.1-2": {
      "clause": "EN-976a8c89163f509a",
      "reason": "The 6.1 reference Solidity verifies the proofs over the statement for (p,h] with the batch's blob hashes; the model's land and the theorems cited for that block cover it."
    },
    "LAND-6.1-3": {
      "clause": "EN-976a8c89163f509a",
      "reason": "The 6.1 reference Solidity reads c and writes the record for the edge c to h; the model's land settles only the suffix above c."
    },
    "LAND-6.1-5": {
      "clause": "EN-976a8c89163f509a",
      "reason": "The 6.1 reference Solidity rejects p or h off the K grid (OffGrid); the model's BaseOK has the same grid conjuncts."
    },
    "LAND-6.1-6": {
      "clause": "EN-976a8c89163f509a",
      "reason": "The 6.1 reference Solidity is the check list (range, grid, origin, leaves, FI head, reference block, blobs, proofs); the model's LandingAllowed states the same checks."
    },
    "LAND-6.1-7": {
      "clause": "EN-976a8c89163f509a",
      "reason": "The 6.1 reference Solidity requires exactly (h - p) / K - 1 leaves (LeafCountMismatch); the model's LeavesOK has the same count."
    },
    "LAND-6.1-8": {
      "clause": "EN-976a8c89163f509a",
      "reason": "The 6.1 reference Solidity compares the leaf at c with cutLeaf over c's record (FrontierLeafMismatch); the model's LeavesOK has the same comparison."
    },
    "LAND-6.1-9": {
      "clause": "EN-976a8c89163f509a",
      "reason": "The 6.1 reference Solidity writes lastCheckpoint, the snapshot, the FI head, the slot 285 record and the SignalService checkpoint in one call; the model's applyLanding writes the same state."
    }
  },
