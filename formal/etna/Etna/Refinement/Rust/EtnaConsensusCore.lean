                  insert_epoch := (some epoch),
                  switch :=
                    (some
                      {
                        outgoing_epoch := outgoing,
                        incoming_epoch := target,
                        prune_before := outgoing
                      })
                })
            else
              ok (core.result.Result.Err (transition.CommitteeError.Unknown
                target))
        else
          ok (core.result.Result.Err (transition.CommitteeError.Unknown
            outgoing))
  | transition.DerivedRelation.Equal epoch =>
    let o ← schedule.Schedule.switch_target epoch_schedule height
    match o with
    | none =>
      ok (core.result.Result.Ok
        { insert_epoch := (some epoch), switch := none })
    | some target =>
      let outgoing ← target - 1#u64
      if facts.outgoing_known
      then
        if facts.incoming_known
        then
          ok (core.result.Result.Ok
            {
              insert_epoch := (some epoch),
              switch :=
                (some
                  {
                    outgoing_epoch := outgoing,
                    incoming_epoch := target,
                    prune_before := outgoing
                  })
            })
        else
          if epoch = target
          then
            ok (core.result.Result.Ok
              {
                insert_epoch := (some epoch),
                switch :=
                  (some
                    {
                      outgoing_epoch := outgoing,
                      incoming_epoch := target,
                      prune_before := outgoing
                    })
              })
          else
            ok (core.result.Result.Err (transition.CommitteeError.Unknown
              target))
      else
        if epoch = outgoing
        then
          if facts.incoming_known
          then
            ok (core.result.Result.Ok
              {
                insert_epoch := (some epoch),
                switch :=
                  (some
                    {
                      outgoing_epoch := outgoing,
                      incoming_epoch := target,
                      prune_before := outgoing
                    })
              })
          else
            if epoch = target
            then
              ok (core.result.Result.Ok
                {
                  insert_epoch := (some epoch),
                  switch :=
                    (some
                      {
                        outgoing_epoch := outgoing,
                        incoming_epoch := target,
                        prune_before := outgoing
                      })
                })
            else
              ok (core.result.Result.Err (transition.CommitteeError.Unknown
                target))
        else
          ok (core.result.Result.Err (transition.CommitteeError.Unknown
            outgoing))
  | transition.DerivedRelation.Conflicting epoch =>
    ok (core.result.Result.Err (transition.CommitteeError.Conflict epoch))

end etna_consensus_core
